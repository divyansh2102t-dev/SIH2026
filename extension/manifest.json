{
  "manifest_version": 3,
  "name": "ISRO Privacy-Preserving Vision Agent",
  "version": "1.0.0",
  "description": "On-Device Visual Perception and PII Redaction for Lightweight Browser Agents (SIH 2026 - PS 26171 by ISRO)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/pii-regex.js",
        "content/dom-analyzer.js",
        "content/action-executor.js",
        "content/content-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ISRO Privacy Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen/*",
        "lib/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
